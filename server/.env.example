# ── 数据库 ──
DB_PASSWORD=your_db_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=marathon
DB_USER=root

# ── 微信小程序（静默登录） ──
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here

# ── JWT 密钥（生产环境务必更换） ──
SECRET_KEY=change-this-to-a-random-secret-in-production
TOKEN_EXPIRE_HOURS=720

# ── 应用 ──
APP_NAME=Marathon Mini-Program API
DEBUG=true

# ── 数据管道 ──
PIPELINE_REQUIRE_REVIEW=true
PIPELINE_CONFIDENCE_THRESHOLD=75

# ── LLM（AI 兜底解析 + enrich 流水线必需）──
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# ── enrich 流水线（列表卡片 → LLM 联网补全 → mi_event）──
PIPELINE_ENRICH_ENABLED=true
PIPELINE_ENRICH_CRON=30 6 * * *
ENRICH_USE_DETAIL_PAGE=false
ENRICH_USE_WEB_GROUNDING=false
