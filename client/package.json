{
  "name": "marathon-mini-program",
  "version": "1.0.0",
  "private": true,
  "description": "马拉松赛事追踪小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp && node scripts/fix-dist.js weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "build:tt": "taro build --type tt && node scripts/fix-dist.js tt",
    "dev:tt": "taro build --type tt --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "taro build --type h5 --watch",
    "build:all": "taro build --type weapp && node scripts/fix-dist.js weapp && taro build --type tt && node scripts/fix-dist.js tt"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@tarojs/components": "4.1.11",
    "@tarojs/helper": "4.1.11",
    "@tarojs/plugin-framework-react": "4.1.11",
    "@tarojs/plugin-platform-h5": "4.1.11",
    "@tarojs/plugin-platform-tt": "^4.1.11",
    "@tarojs/plugin-platform-weapp": "4.1.11",
    "@tarojs/react": "4.1.11",
    "@tarojs/runtime": "4.1.11",
    "@tarojs/shared": "4.1.11",
    "@tarojs/taro": "4.1.11",
    "@tarojs/webpack5-prebundle": "4.1.11",
    "ajv": "^8.20.0",
    "province-city-china": "^8.5.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.24.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@tarojs/cli": "4.1.11",
    "@tarojs/webpack5-runner": "4.1.11",
    "@types/react": "^18.3.0",
    "babel-preset-taro": "4.1.11",
    "react-refresh": "^0.18.0",
    "sass": "^1.77.0",
    "typescript": "^5.4.0",
    "webpack": "5.91.0"
  }
}
